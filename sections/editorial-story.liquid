<section class="story{% if section.settings.reverse %} story--reverse{% endif %}" data-section-id="{{ section.id }}">
  <div class="story__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
    {%- else -%}
      <div style="background:linear-gradient(140deg,#dec9c0,#9e8576);width:100%;height:100%;"></div>
    {%- endif -%}
  </div>
  <div class="story__body">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="story__title">{{ section.settings.title }}</h2>
    <p class="story__text">{{ section.settings.body }}</p>
    {%- if section.settings.cta_url != blank -%}
      <p style="margin-top:12px;"><a class="ulink eyebrow" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }} →</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Origins" },
    { "type": "text", "id": "title", "label": "Title", "default": "From a single distillation in Kannauj." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Our compositions begin in north India — at copper stills that have run for two centuries, in fields where the rose is harvested before the third hour. We work without compromise: with attars, with absolutes, with the patience that real fragrance demands." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read the journal" },
    { "type": "url", "id": "cta_url", "label": "CTA url" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false }
  ],
  "presets": [{ "name": "Editorial story" }]
}
{% endschema %}
